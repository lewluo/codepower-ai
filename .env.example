# OpenAI-compatible LLM used by xiaozhi-server.
CODEPOWER_LLM_API_KEY=

# OpenAI speech-to-text used by ASR: OpenaiASR.
OPENAI_ASR_API_KEY=

# Doubao / Volcano TTS used by TTS: DoubaoTTS.
DOUBAO_TTS_APPID=
DOUBAO_TTS_ACCESS_TOKEN=

# Optional JoyInside custom skill gateway auth.
JOYINSIDE_SERVICE_TOKEN=
JOYINSIDE_GATEWAY_PORT=9100

# Agent backend routing. Default task mode uses Hermes; OpenClaw stays enabled for explicit tasks.
CODEPOWER_AGENT_BACKEND=hermes
CODEPOWER_AGENT_BACKENDS=hermes,openclaw
CODEPOWER_AGENT_FALLBACK_BACKENDS=
CODEPOWER_DEFAULT_AGENT=planner
CODEPOWER_AGENT_REGISTRY=planner:任务规划,executor:任务执行
CODEPOWER_OPENCLAW_BIN=openclaw
CODEPOWER_OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
CODEPOWER_OPENCLAW_DEFAULT_AGENT=planner

# JoyInside outbound LLM bridge.
JOYINSIDE_ACCESS_KEY=
JOYINSIDE_SECRET_KEY=
JOYINSIDE_VENDOR_ID=
JOYINSIDE_APP_ID=
JOYINSIDE_DEVICE_ID=codepower-local-xiaozhi
JOYINSIDE_DEVICE_NAME=CodePower-Local-Xiaozhi
JOYINSIDE_BOT_ID=
JOYINSIDE_UID=codepower-local-user

# Resend Email API
RESEND_API_KEY=
RESEND_FROM_NAME=PowCoder
RESEND_FROM_EMAIL=hello@notify.powcoder.space
# 预置联系人（格式：名字:邮箱，逗号分隔）
RESEND_CONTACTS=
