# OpenAI-compatible LLM used by xiaozhi-server.
CODEPOWER_LLM_API_KEY=

# OpenAI speech-to-text used by ASR: OpenaiASR.
OPENAI_ASR_API_KEY=

# Doubao / Volcano TTS used by TTS: DoubaoTTS.
DOUBAO_TTS_APPID=
DOUBAO_TTS_ACCESS_TOKEN=

# Optional JoyInside custom skill gateway auth.
JOYINSIDE_SERVICE_TOKEN=
JOYINSIDE_GATEWAY_PORT=9100

# JoyInside outbound LLM bridge.
JOYINSIDE_ACCESS_KEY=
JOYINSIDE_SECRET_KEY=
JOYINSIDE_VENDOR_ID=
JOYINSIDE_APP_ID=
JOYINSIDE_DEVICE_ID=codepower-local-xiaozhi
JOYINSIDE_DEVICE_NAME=CodePower-Local-Xiaozhi
JOYINSIDE_BOT_ID=
JOYINSIDE_UID=codepower-local-user
