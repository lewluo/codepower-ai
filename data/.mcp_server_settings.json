{
  "mcpServers": {
    "openclaw-dispatcher": {
      "url": "http://127.0.0.1:9001/mcp",
      "transport": "streamable-http",
      "headers": {}
    },
    "openclaw-local": {
      "command": "openclaw",
      "args": [
        "mcp",
        "serve",
        "--url",
        "ws://127.0.0.1:18789",
        "--claude-channel-mode",
        "off"
      ],
      "env": {}
    }
  }
}
