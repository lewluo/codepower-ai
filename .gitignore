# ── 第三方源码(默认不进仓库,仅放行 xiaozhi-server) ─────
repo/*
!repo/main/
repo/main/*
!repo/main/xiaozhi-server/
!repo/main/xiaozhi-server/**
repo/main/xiaozhi-server/.venv/
repo/main/xiaozhi-server/venv/
repo/main/xiaozhi-server/data/
repo/main/xiaozhi-server/tmp/
repo/main/xiaozhi-server/**/*.log
repo.tar.gz

# ── 大模型文件(近 1GB) ──────────────────────────────
models/**/*.pt
models/**/*.onnx
models/**/*.bin
models/**/*.safetensors

# ── 虚拟环境 ────────────────────────────────────────
.venv/
venv/
**/.venv/
**/venv/

# ── 敏感配置(含 api_key) ────────────────────────────
data/.config.yaml

# ── 运行时产物 ──────────────────────────────────────
*.log
*.pid
tmp/
**/tmp/
/tmp/xiaozhi-dispatcher-*

# ── Python ──────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── macOS / IDE ─────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# ── 环境变量 ────────────────────────────────────────
.env
.env.local
.env.*.local
