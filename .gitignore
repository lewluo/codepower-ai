# ── 第三方源码(克隆,不进仓库) ──────────────────────
repo/

# ── 大模型文件(近 1GB) ──────────────────────────────
models/**/*.pt
models/**/*.onnx
models/**/*.bin
models/**/*.safetensors

# ── 虚拟环境 ────────────────────────────────────────
.venv/
venv/
**/.venv/
**/venv/

# ── 敏感配置(含 api_key) ────────────────────────────
data/.config.yaml

# ── 运行时产物 ──────────────────────────────────────
*.log
*.pid
tmp/
**/tmp/
/tmp/xiaozhi-dispatcher-*

# ── Python ──────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── macOS / IDE ─────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# ── 环境变量 ────────────────────────────────────────
.env
.env.local
.env.*.local
